//--------------------------------------------------------------------------------------------------
// Trigger: AP_Triggers_ChangeMusic
//--------------------------------------------------------------------------------------------------
bool libABFE498B_gt_AP_Triggers_ChangeMusic_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_track;
    int lv_race;
    string lv_music;
    text lv_text1;
    text lv_text2;

    // Automatic Variable Declarations
    string auto7EE59BFF_val;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!(((StringWord(EventChatMessage(false), 1) == "-m") || (StringWord(EventChatMessage(false), 1) == "-music")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    SoundtrackStop(PlayerGroupAll(), c_soundtrackCategoryMusic, true);
    if ((StringLength(StringWord(EventChatMessage(false), 2)) > 0)) {
        lv_track = StringToInt(StringWord(EventChatMessage(false), 2));
    }
    else {
        lv_track = 0;
    }
    if ((StringLength(StringWord(EventChatMessage(false), 3)) > 0)) {
        lv_race = StringToInt(StringWord(EventChatMessage(false), 3));
    }
    else {
        lv_race = 0;
    }
    if ((lv_track <= 0)) {
        lv_text1 = StringExternal("Param/Value/lib_ABFE498B_0BC9D81C");
        lv_track = c_soundtrackIndexAny;
    }
    else {
        TextExpressionSetToken("Param/Expression/lib_ABFE498B_8683CB8E", "A", IntToText(lv_track));
        lv_text1 = TextExpressionAssemble("Param/Expression/lib_ABFE498B_8683CB8E");
        lv_track -= 1;
    }
    if (((lv_race <= 0) || (lv_race > 3))) {
        auto7EE59BFF_val = PlayerRace(EventPlayer());
        if (auto7EE59BFF_val == "Terr") {
            lv_race = 1;
        }
        else if (auto7EE59BFF_val == "Zerg") {
            lv_race = 2;
        }
        else if (auto7EE59BFF_val == "Prot") {
            lv_race = 3;
        }
        else {
        }
    }

    lv_music = libABFE498B_gv_aP_Triggers_Soundtrack[lv_race];
    lv_text2 = libABFE498B_gv_aP_Triggers_RaceNames[lv_race];
    TextExpressionSetToken("Param/Expression/lib_ABFE498B_E115F994", "A", lv_text1);
    TextExpressionSetToken("Param/Expression/lib_ABFE498B_E115F994", "B", lv_text2);
    TriggerDebugOutput(1, TextExpressionAssemble("Param/Expression/lib_ABFE498B_E115F994"), true);
    Wait(1.0, c_timeReal);
    SoundtrackPlay(PlayerGroupAll(), c_soundtrackCategoryMusic, lv_music, c_soundtrackCueAny, lv_track, false);
    return true;
}

