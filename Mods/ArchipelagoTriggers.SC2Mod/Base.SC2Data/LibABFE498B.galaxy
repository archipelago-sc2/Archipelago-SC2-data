    libABFE498B_gt_AP_Triggers_ChangeMusic = TriggerCreate("libABFE498B_gt_AP_Triggers_ChangeMusic_Func");
    TriggerAddEventChatMessage(libABFE498B_gt_AP_Triggers_ChangeMusic, c_playerAny, "-music", false);
    TriggerAddEventChatMessage(libABFE498B_gt_AP_Triggers_ChangeMusic, c_playerAny, "-m", false);
