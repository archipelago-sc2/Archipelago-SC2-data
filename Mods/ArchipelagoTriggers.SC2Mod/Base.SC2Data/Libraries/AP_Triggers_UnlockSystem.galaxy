void AP_DebugTech(int player, int lvl) {
    // Unlocks a "standard" AP loadout for single player testing
    // for a mission of the given difficulty
    // 0 - very easy, 1 - easy, 2 - medium, 3 - hard, 4 - very hard
    int i;
    int step;
    lvl = MinI(5, MaxI(0, lvl));
    if (lvl == 0) {
        AP_UnlockTerranUnits(player,"1");
        AP_UnlockZergUnits(player,"1");
        AP_UnlockProtossUnits(player,"1");
    }
    if (lvl >= 1) {
        // lazy implementation. TODO (Snarky): Select a proper loadout for each tech level
        step = 6 - lvl; // lvl 1: unlock every 5th item. lvl 5: unlock every item
        for (i = 0; i < ITEM_SPACE; i += step) {
            UnlockItem(player, i);
        }
        for (i = 0; i < PROGRESSIVE_SPACE; i += step) {
            UnlockProgressive(player, i, lvl);
        }
    }
    for (i = 0; i < 5; i += 1) {
        AP_HandleTerranUpgrade(player, lvl, i, 0);
        AP_HandleZergUpgrade(player, lvl, i);
        AP_HandleProtossUpgrade(player, lvl, i);
        lib15EF4C78_gf_ZS_ApplyKerriganLevelBonus(player, 10 * lvl);
    }
    AP_HandleTerranUpgrade(player, lvl, 6, 0);
}

