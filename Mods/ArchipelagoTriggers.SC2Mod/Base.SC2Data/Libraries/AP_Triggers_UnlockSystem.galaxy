// A library for handling AP item unlocks
include "Libraries/AP_Triggers_UnlockSystem_h"

// Constants
static const int ITEM_SPACE = 2100;
static const int OFFSET_TERRAN_UNIT = 0;                                    // In Use: < 70
static const int OFFSET_TERRAN_ITEM = OFFSET_TERRAN_UNIT + 200;             // < 300
static const int OFFSET_ZERG_UNIT = OFFSET_TERRAN_ITEM + 500;               // < 50
static const int OFFSET_ZERG_ITEM = OFFSET_ZERG_UNIT + 200;                 // < 210
static const int OFFSET_PROTOSS_UNIT = OFFSET_ZERG_ITEM + 500;              // < 60
static const int OFFSET_PROTOSS_ITEM = OFFSET_PROTOSS_UNIT + 200;           // < 270

static const int PROGRESSIVE_SPACE = 210;
static const int OFFSET_TERRAN_PROGRESSIVE = 0;                             // < 20
static const int OFFSET_TERRAN_UPGRADE = OFFSET_TERRAN_PROGRESSIVE + 50;    // < 20
static const int OFFSET_ZERG_PROGRESSIVE = OFFSET_TERRAN_UPGRADE + 20;      // < 10
static const int OFFSET_ZERG_UPGRADE = OFFSET_ZERG_PROGRESSIVE + 50;        // < 10
static const int OFFSET_PROTOSS_PROGRESSIVE = OFFSET_ZERG_UPGRADE + 20;     // < 10
static const int OFFSET_PROTOSS_UPGRADE = OFFSET_PROTOSS_PROGRESSIVE + 50;  // < 10

// Globals
static void ItemFuncSignature(int player) {}
typedef funcref<ItemFuncSignature> AP_ItemFunc;
struct AP_Item {
    int Id;
    string Upgrade;
    AP_ItemFunc UnlockFunc;
};
static AP_Item[ITEM_SPACE] ItemDatabase;

static void ProgressiveFuncSignature(int player, int level) {}
typedef funcref<ProgressiveFuncSignature> AP_ProgressiveFunc;
struct AP_Progressive {
    int Id;
    string UpgradeLevel1;
    string UpgradeLevel2;
    AP_ProgressiveFunc UnlockFunc;
};
static AP_Progressive[PROGRESSIVE_SPACE] ProgressiveDatabase;

// We don't expect this to ever change, just hardcode the sizes
static string[22][5] WAUpgradeDatabase;
static string[22][2] WAUpgradeSpeedupDatabase;

static unitfilter UnitFilterStandard = UnitFilter(0, 0, (1 << c_targetFilterMissile),
    (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)));

// Functions
static void log(string s) {
    TriggerDebugOutput(1, StringToText("Item Unlock System: " + s), false);
}

static void RegisterItem(int id, int offset, string upgrade, AP_ItemFunc itemFunc) {
    int index = id + offset;
    if (ItemDatabase[index].Id != 0) {
        log("Warning: Multiple uses of Item index " + IntToString(index));
    }
    ItemDatabase[index].Id = id;
    ItemDatabase[index].Upgrade = upgrade;
    ItemDatabase[index].UnlockFunc = itemFunc;
}

void AP_RegisterTerranUnit(int id, string upgrade, AP_ItemFunc itemFunc) {
    RegisterItem(id, OFFSET_TERRAN_UNIT, upgrade, itemFunc);
}

void AP_RegisterZergUnit(int id, string upgrade, AP_ItemFunc itemFunc) {
    RegisterItem(id, OFFSET_ZERG_UNIT, upgrade, itemFunc);
}

void AP_RegisterProtossUnit(int id, string upgrade, AP_ItemFunc itemFunc) {
    RegisterItem(id, OFFSET_PROTOSS_UNIT, upgrade, itemFunc);
}

void AP_RegisterTerranItem(int id, string upgrade) {
    RegisterItem(id, OFFSET_TERRAN_ITEM, upgrade, null);
}

void AP_RegisterTerranItemFunc(int id, string upgrade, AP_ItemFunc itemFunc) {
    RegisterItem(id, OFFSET_TERRAN_ITEM, upgrade, itemFunc);
}

void AP_RegisterZergItem(int id, string upgrade) {
    RegisterItem(id, OFFSET_ZERG_ITEM, upgrade, null);
}

void AP_RegisterZergItemFunc(int id, string upgrade, AP_ItemFunc itemFunc) {
    RegisterItem(id, OFFSET_ZERG_ITEM, upgrade, itemFunc);
}

void AP_RegisterProtossItem(int id, string upgrade) {
    RegisterItem(id, OFFSET_PROTOSS_ITEM, upgrade, null);
}

void AP_RegisterProtossItemFunc(int id, string upgrade,  AP_ItemFunc itemFunc) {
    RegisterItem(id, OFFSET_PROTOSS_ITEM, upgrade, itemFunc);
}

static void RegisterProgressive(int id, int offset, int bits, string upgrade1, string upgrade2, AP_ProgressiveFunc itemFunc) {
    int index = id/bits + offset;
    if (ProgressiveDatabase[index].Id != 0) {
        log("Warning: Multiple uses of Item index " + IntToString(index));
    }
    ProgressiveDatabase[index].Id = id;
    ProgressiveDatabase[index].UpgradeLevel1 = upgrade1;
    ProgressiveDatabase[index].UpgradeLevel2 = upgrade2;
    ProgressiveDatabase[index].UnlockFunc = itemFunc;
}

void AP_RegisterTerranProgressive(int id, string upgrade1, string upgrade2) {
    // common case of progressive with 2 levels. More levels/upgrades needs to handle it with the function.
    RegisterProgressive(id, OFFSET_TERRAN_PROGRESSIVE, 2, upgrade1, upgrade2, null);
}

void AP_RegisterTerranProgressiveFunc(int id, AP_ProgressiveFunc itemFunc) {
    // most progressives that need a function don't seem to want to set the upgrades
    RegisterProgressive(id, OFFSET_TERRAN_PROGRESSIVE, 2, null, null, itemFunc);
}

void AP_RegisterZergProgressive(int id, string upgrade1, string upgrade2) {
    RegisterProgressive(id, OFFSET_ZERG_PROGRESSIVE, 2, upgrade1, upgrade2, null);
}

void AP_RegisterZergProgressiveFunc(int id, AP_ProgressiveFunc itemFunc) {
    RegisterProgressive(id, OFFSET_ZERG_PROGRESSIVE, 2, null, null, itemFunc);
}

void AP_RegisterProtossProgressive(int id, string upgrade1, string upgrade2) {
    RegisterProgressive(id, OFFSET_PROTOSS_PROGRESSIVE, 2, upgrade1, upgrade2, null);
}

void AP_RegisterProtossProgressiveFunc(int id, AP_ProgressiveFunc itemFunc) {
    RegisterProgressive(id, OFFSET_PROTOSS_PROGRESSIVE, 2, null, null, itemFunc);
}

void AP_RegisterTerranUpgrade(int id, AP_ProgressiveFunc itemFunc) {
    RegisterProgressive(id, OFFSET_TERRAN_UPGRADE, 4, null, null, itemFunc);
}

void AP_RegisterZergUpgrade(int id, AP_ProgressiveFunc itemFunc) {
    RegisterProgressive(id, OFFSET_ZERG_UPGRADE, 4, null, null, itemFunc);
}

void AP_RegisterProtossUpgrade(int id, AP_ProgressiveFunc itemFunc) {
    RegisterProgressive(id, OFFSET_PROTOSS_UPGRADE, 4, null, null, itemFunc);
}

static void UnlockItem(int player, int index) {
    // log("unlocking index: " + IntToString(index));
    if (ItemDatabase[index].Upgrade != null) {
        // log("upgrade: " + ItemDatabase[index].Upgrade);
        TechTreeUpgradeAddLevel(player, ItemDatabase[index].Upgrade, 1);
    }
    if (ItemDatabase[index].UnlockFunc != null) {
        ItemDatabase[index].UnlockFunc(player);
    }
}

static void UnlockProgressive(int player, int index, int level) {
    int slot = ProgressiveDatabase[index].Id;
    // log("unlocking progressive level: " + IntToString(level) + " at slot: " + IntToString(slot));
    if (level >= 1 && ProgressiveDatabase[index].UpgradeLevel1 != null) {
        TechTreeUpgradeAddLevel(player, ProgressiveDatabase[index].UpgradeLevel1, 1);
    }
    if (level >= 2 && ProgressiveDatabase[index].UpgradeLevel2 != null) {
        TechTreeUpgradeAddLevel(player, ProgressiveDatabase[index].UpgradeLevel2, 1);
    }
    if (ProgressiveDatabase[index].UnlockFunc != null) {
        ProgressiveDatabase[index].UnlockFunc(player, level);
    }
}

static void UnlockItems(int player, int offset, string hexInput) {
    int length = StringLength(hexInput);
    int fourBits;
    int index;
    int i; int j;
    if (player <= 0) {
        player = lib5BD4895D_gf_AP_Core_getUser();
    }
    // log("Input: " + hexInput);
    for (i = length; i > 0; i -= 1) {
        fourBits = AP_HexDigitToInt(StringSub(hexInput, i, i));
        // log("four bits " + IntToString(i) + ": " + IntToString(fourBits));
        if (fourBits <= 0) { continue; }
        for (j = 0; j < 4; j += 1) {
            index = (4 * (length - i)) + j + offset;
            if ((fourBits & 1) == 1) {
                UnlockItem(player, index);
            }
            fourBits = (fourBits >> 1);
        }
    }
}

// Regular progressive items always consume 2 bits (which means their max lvl is 3)
// anything with higher lvls needs to be handled separately
static void UnlockProgressives(int player, int offset, string hexInput) {
    int length = StringLength(hexInput);
    int fourBits;
    int level;
    int index;
    int i; int j;
    if (player <= 0) {
        player = lib5BD4895D_gf_AP_Core_getUser();
    }
    // log("Input: " + hexInput);
    for (i = length; i > 0; i -= 1) {
        fourBits = AP_HexDigitToInt(StringSub(hexInput, i, i));
        // log("FourBits: " + IntToString(fourBits));
        for (j = 0; j < 2; j += 1) {
            if (fourBits <= 0) { continue; }
            index = 2 * (length - i) + j;
            level = fourBits & 3;
            UnlockProgressive(player, index + offset, level);
            fourBits = (fourBits >> 2);
        }
    }
}

// W/A upgrades always consume 1 full hex char
static void UnlockUpgrades(int player, int offset, string hexInput) {
    int length = StringLength(hexInput);
    int fourBits;
    int level;
    int index;
    int i;
    if (player <= 0) {
        player = lib5BD4895D_gf_AP_Core_getUser();
    }
    // log("Upgrades Input: " + hexInput);
    for (i = length; i > 0; i -= 1) {
        fourBits = AP_HexDigitToInt(StringSub(hexInput, i, i));
        // log("FourBits: " + IntToString(fourBits));
        if (fourBits <= 0) { continue; }
        index = length - i;
        UnlockProgressive(player, index + offset, fourBits);
    }
}


static bool IsUpgradeAuto(int player) {
    int researchMode = libABFE498B_gv_aP_Triggers_Option_genericUpgradeResearch;
    if (libABFE498B_gv_aP_Triggers_isBuild) {
        return researchMode == 2 || researchMode == 3;
    }
    else {
        return researchMode == 1 || researchMode == 3;
    }
}

void AP_HandleTerranUpgrade(int player, int level, int index, int modifier) {
    int i;
    if (IsUpgradeAuto(player)) {
        for (i = 0; i < level; i += 1) {
            TechTreeUpgradeAddLevel(player, WAUpgradeDatabase[index][i], 1);
        }
    }
    else {
        for (i = 0; i < level; i += 1) {
            TechTreeUpgradeAllow(player, WAUpgradeDatabase[index][i], true);
            TechTreeUpgradeAllow(player, WAUpgradeDatabase[index + modifier][i], true);
        }
        if (libABFE498B_gv_aP_Triggers_Option_genericUpgradeResearchSpeedup) {
            for (i = 0; i < level - 3; i += 1) {
                TechTreeUpgradeAddLevel(player, WAUpgradeSpeedupDatabase[index / 2][i], 1);
            }
        }
    }
}

void AP_HandleZergUpgrade(int player, int level, int index) {
    int i;
    if (level >= 2) {
        TechTreeUpgradeAddLevel(player, "AP_UnlockLair", 1);
    }
    if (level >= 3) {
        TechTreeUpgradeAddLevel(player, "AP_UnlockHive", 1);
    }
    if (IsUpgradeAuto(player)) {
        for (i = 0; i < level; i += 1) {
            TechTreeUpgradeAddLevel(player, WAUpgradeDatabase[index + 12][i], 1);
        }
    }
    else {
        for (i = 0; i < level; i += 1) {
            TechTreeUpgradeAllow(player, WAUpgradeDatabase[index + 12][i], true);
        }
        if (libABFE498B_gv_aP_Triggers_Option_genericUpgradeResearchSpeedup) {
            for (i = 0; i < level - 3; i += 1) {
                TechTreeUpgradeAddLevel(player, WAUpgradeSpeedupDatabase[index + 6][i], 1);
            }
        }
    }
}

void AP_HandleProtossUpgrade(int player, int level, int index) {
    int i;
    if (IsUpgradeAuto(player)) {
        for (i = 0; i < level; i += 1) {
            TechTreeUpgradeAddLevel(player, WAUpgradeDatabase[index + 17][i], 1);
        }
    }
    else {
        for (i = 0; i < level; i += 1) {
            TechTreeUpgradeAllow(player, WAUpgradeDatabase[index + 17][i], true);
        }
        if (libABFE498B_gv_aP_Triggers_Option_genericUpgradeResearchSpeedup) {
            for (i = 0; i < level - 3; i += 1) {
                TechTreeUpgradeAddLevel(player, WAUpgradeSpeedupDatabase[index + 11][i], 1);
            }
        }
    }
}

void AP_ClearUpgrades(int player) {
    int i; int j;
    for (i = 0; i < 22; i += 1) {
        for (j = 0; j < 5; j += 1) {
            TechTreeUpgradeAllow(player, WAUpgradeDatabase[i][j], false);
        }
    }
}

