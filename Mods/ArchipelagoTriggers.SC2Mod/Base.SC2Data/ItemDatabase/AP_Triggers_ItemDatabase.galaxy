// Protoss Building Unlock Functions
void UnlockGateway(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockGateway", 1);
}

void UnlockCyberneticsCore(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockCyberneticsCore", 1);
}

void UnlockTemplarArchives(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockTemplarArchives", 1);
}

void UnlockDarkShrine(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockDarkShrine", 1);
}

void UnlockGatewayAndCyberneticsCore(int player) {
    UnlockGateway(player);
    UnlockCyberneticsCore(player);
}

void UnlockGatewayAndTemplarArchives(int player) {
    UnlockGateway(player);
    UnlockTemplarArchives(player);
}

void UnlockGatewayAndDarkShrine(int player) {
    UnlockGateway(player);
    UnlockDarkShrine(player);
}

void UnlockRoboticsFacility(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockRoboticsFacility", 1);
}

void UnlockRoboticsBay(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockRoboticsBay", 1);
}

void UnlockRoboticsAndBay(int player) {
    UnlockRoboticsFacility(player);
    UnlockRoboticsBay(player);
}
void UnlockStargate(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockStargate", 1);
}

void UnlockFleetBeacon(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockFleetBeacon", 1);
}

void UnlockStargateAndFleetBeacon(int player) {
    UnlockStargate(player);
    UnlockFleetBeacon(player);
}

void UnlockStargateCyberAndFleetBeacon(int player) {
    UnlockStargate(player);
    UnlockCyberneticsCore(player);
    UnlockFleetBeacon(player);
}

void UnlockForge(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockForge", 1);
}

