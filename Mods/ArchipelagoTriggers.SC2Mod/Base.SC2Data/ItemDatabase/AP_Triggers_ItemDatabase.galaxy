// Zerg Unit Unlock Functions
static void UnlockMorphling(int player) {
    if (libABFE498B_gv_aP_Triggers_Option_enableMorphling) {
        TechTreeUpgradeAddLevel(player, "AP_UnlockMorphling", 1);
    }
}

static void UnlockBanelingFunc(int player) {
    UnlockBanelingNest(player);
    UnlockMorphling(player);
}

static void UnlockLurkerImpalerFunc(int player) {
    UnlockGreaterHydraliskDen(player);
    UnlockMorphling(player);
    if (TechTreeUpgradeCount(player,"AP_HotSImpaler", c_techCountCompleteOnly) > 0
    && TechTreeUpgradeCount(player,"AP_HotSLurker", c_techCountCompleteOnly) > 0) {
        TechTreeUpgradeAddLevel(player, "AP_HotSLurkerImpaler", 1);
    }
}

static void UnlockImpalerFunc(int player) {
    TechTreeUpgradeAddLevel(player, "AP_HotSImpaler", 1);
    UnlockLurkerImpalerFunc(player);
}

static void UnlockLurkerFunc(int player) {
    TechTreeUpgradeAddLevel(player, "AP_HotSLurker", 1);
    UnlockLurkerImpalerFunc(player);
}

static void UnlockBroodLordViperFunc(int player) {
    UnlockGreaterSpire(player);
    UnlockMorphling(player);
    if (TechTreeUpgradeCount(player,"AP_HotSMutaliskViper", c_techCountCompleteOnly) > 0
    && TechTreeUpgradeCount(player,"AP_HotSMutaliskBroodlord", c_techCountCompleteOnly) > 0) {
        TechTreeUpgradeAddLevel(player, "AP_HotSMutaliskBroodlordViper", 1);
    }
}

static void UnlockBroodLordFunc(int player) {
    TechTreeUpgradeAddLevel(player, "AP_HotSMutaliskBroodlord", 1);
    UnlockBroodLordViperFunc(player);
}

static void UnlockViperFunc(int player) {
    TechTreeUpgradeAddLevel(player, "AP_HotSMutaliskViper", 1);
    UnlockBroodLordViperFunc(player);
}

static void UnlockGuardianFunc(int player) {
    TechTreeUpgradeAddLevel(player, "AP_GuardianAspect", 1);
    UnlockGreaterSpire(player);
    UnlockMorphling(player);
}

static void UnlockDevourerFunc(int player) {
    TechTreeUpgradeAddLevel(player, "AP_DevourerAspect", 1);
    UnlockGreaterSpire(player);
    UnlockMorphling(player);
}

static void UnlockRavagerFunc(int player) {
    TechTreeUpgradeAddLevel(player, "AP_MorphToRavager", 1);
    UnlockRoachWarren(player);
    UnlockLair(player);
    UnlockMorphling(player);
}

static void UnlockTyrannozorFunc(int player) {
    UnlockUltraliskCavern(player);
    UnlockMorphling(player);
}

static void UnlockPrimalIgniterFunc(int player) {
    UnlockRoachWarren(player);
    UnlockMorphling(player);
}

