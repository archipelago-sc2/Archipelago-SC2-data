void AP_ClearTech(int player) {
    AP_ClearUpgrades(player);
}

void AP_UnlockDefaultTech(int player) {

    // Terran
    TechTreeUpgradeAddLevel(player,"AP_SiegeTech", 1);
    TechTreeUpgradeAddLevel(player,"AP_WraithCloak", 1);
    TechTreeUpgradeAddLevel(player,"AP_BansheeCloak", 1);
    TechTreeUpgradeAddLevel(player,"AP_YamatoCannon", 1);
    TechTreeUpgradeAddLevel(player,"AP_NovaBaseSuitEnhancements", 1);
    TechTreeUpgradeAddLevel(player,"AP_ReaperSpeed", 1);

    // Unlock Tech Labs + Reactors unconditionally to allow swap plays
    TechTreeUpgradeAddLevel(player,"AP_UnlockBarracksReactor", 1);
    TechTreeUpgradeAddLevel(player,"AP_UnlockBarracksTechLab", 1);
    TechTreeUpgradeAddLevel(player,"AP_UnlockFactoryReactor", 1);
    TechTreeUpgradeAddLevel(player,"AP_UnlockFactoryTechLab", 1);
    TechTreeUpgradeAddLevel(player,"AP_UnlockStarportReactor", 1);
    TechTreeUpgradeAddLevel(player,"AP_UnlockStarportTechLab", 1);

    // Zerg
    TechTreeUpgradeAddLevel(player,"AP_KerriganPostLabSounds", 1);
    TechTreeUpgradeAddLevel(player,"AP_OverlordContaminate", 1);

    // Protoss
    TechTreeUpgradeAddLevel(player,"AP_SlayerConfig", 1);
    TechTreeUpgradeAddLevel(player,"AP_AlarakStalkerPhasingArmor", 1);
    TechTreeUpgradeAddLevel(player,"AP_VoidRayBeamCanCharge", 1);
}

static void InitTech() {
    int i; int p;
    for (i = 1; i <= PlayerGroupCount(lib5BD4895D_gv_aP_Core_affectedPlayers); i += 1) {
        p = PlayerGroupPlayer(lib5BD4895D_gv_aP_Core_affectedPlayers, i);
        AP_ClearTech(p);
        AP_UnlockDefaultTech(p);
    }
}

void AP_Triggers_ItemDatabaseInit() {
    RegisterTerranUnits();
    RegisterTerranItems();
    RegisterZergUnits();
    RegisterZergItems();
    RegisterProtossUnits();
    RegisterProtossItems();
    InitTech();
}