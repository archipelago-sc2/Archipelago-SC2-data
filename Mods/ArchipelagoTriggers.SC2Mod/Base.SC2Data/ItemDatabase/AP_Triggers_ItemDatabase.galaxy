// Database of items registered for the unlock system
include "ItemDatabase/AP_Triggers_ItemDatabase_h"

// Globals
static unitfilter UnitFilterStandard = UnitFilter(0, 0, (1 << c_targetFilterMissile),
    (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)));

// Functions
static void log(string s) {
    TriggerDebugOutput(1, StringToText("Item Database: " + s), false);
}

    // ********************** //
    // *       Terran       * //
    // ********************** //

// Terran Building Unlock Functions
static void UnlockBarracks(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockBarracks" , 1);
}

static void UnlockShadowOps(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockShadowOps" , 1);
}

static void UnlockBarracksAndShadowOps(int player) {
    UnlockBarracks(player);
    UnlockShadowOps(player);
}

static void UnlockEngineeringBay(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockEngineeringBay" , 1);
}

static void UnlockPsiDisrupter(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockPsiDisrupter" , 1);
}

static void UnlockPsiDisrupterAndEngineeringBay (int player) {
    UnlockEngineeringBay(player);
    UnlockPsiDisrupter(player);
}

static void UnlockHiveMindEmulator(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockHiveMindEmulator" , 1);
}

static void UnlockHiveMindEmulatorAndEngineeringBay(int player) {
    UnlockEngineeringBay(player);
    UnlockHiveMindEmulator(player);
}

static void UnlockFactory(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockFactory" , 1);
}

static void UnlockArmory(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockArmory" , 1);
}

static void UnlockFactoryAndArmory(int player) {
    UnlockFactory(player);
    UnlockArmory(player);
}

static void UnlockFactoryAndShadowOps(int player) {
    UnlockFactory(player);
    UnlockShadowOps(player);
}

static void UnlockStarport(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockStarport" , 1);
}

static void UnlockFusionCore(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockFusionCore" , 1);
}

static void UnlockStarportAndFusionCore(int player) {
    UnlockStarport(player);
    UnlockFusionCore(player);
}

static void UnlockEliteBarracks(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockEliteBarracks" , 1);
}

static void UnlockEliteFactory(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockEliteFactory" , 1);
}

static void UnlockEliteStarport(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockEliteStarport" , 1);
}

static void UnlockEliteStarportAndFusionCore(int player) {
