// Terran Unit Unlock Functions

static void UnlockHellion(int player) {
    UnlockFactory(player);
    TechTreeUpgradeAddLevel(player, "AP_ToggleHellbat", 1);
}

static void UnlockEmperorsShadow(int player) {
    UnlockEliteBarracks(player);
    TechTreeUpgradeAddLevel(player, "AP_HaveGhostMengsk", 1);
}

// Terran Unit Registration
static void RegisterTerranUnits() {
    // Barracks
    AP_RegisterTerranUnit(0, "AP_UnlockMarine", UnlockBarracks);
    AP_RegisterTerranUnit(1, "AP_UnlockMedic", UnlockBarracks);
    AP_RegisterTerranUnit(2, "AP_UnlockFirebat", UnlockBarracks);
    AP_RegisterTerranUnit(3, "AP_UnlockMarauder", UnlockBarracks);
    AP_RegisterTerranUnit(4, "AP_UnlockReaper", UnlockBarracks);
    AP_RegisterTerranUnit(15, "AP_UnlockGhost", UnlockBarracksAndShadowOps);
    AP_RegisterTerranUnit(16, "AP_UnlockSpectre", UnlockBarracksAndShadowOps);
    AP_RegisterTerranUnit(22, "AP_UnlockHerc", UnlockBarracks);
    AP_RegisterTerranUnit(24, "AP_UnlockDominionTrooper", UnlockBarracks);

    // Factory
    AP_RegisterTerranUnit(5, "AP_UnlockHellion", UnlockHellion);
    AP_RegisterTerranUnit(6, "AP_UnlockVulture", UnlockFactory);
    AP_RegisterTerranUnit(7, "AP_UnlockGoliath", UnlockFactory);
    AP_RegisterTerranUnit(8, "AP_UnlockDiamondback", UnlockFactory);
    AP_RegisterTerranUnit(9, "AP_UnlockSiegeTank", UnlockFactory);
    AP_RegisterTerranUnit(17, "AP_UnlockThor", UnlockFactoryAndArmory);
    AP_RegisterTerranUnit(20, "AP_UnlockWidowMine", UnlockFactory);
    AP_RegisterTerranUnit(21, "AP_UnlockCyclone", UnlockFactory);
    AP_RegisterTerranUnit(23, "AP_UnlockWarhound", UnlockFactory);
    AP_RegisterTerranUnit(59, "AP_UnlockPredator", UnlockFactory);

    // Starport
    AP_RegisterTerranUnit(10, "AP_UnlockMedivac", UnlockStarport);
    AP_RegisterTerranUnit(11, "AP_UnlockWraith", UnlockStarport);
    AP_RegisterTerranUnit(12, "AP_UnlockViking", UnlockStarport);
    AP_RegisterTerranUnit(13, "AP_UnlockBanshee", UnlockStarport);
    AP_RegisterTerranUnit(14, "AP_UnlockBattlecruiser", UnlockStarportAndFusionCore);
    AP_RegisterTerranUnit(18, "AP_UnlockLiberator", UnlockStarport);
    AP_RegisterTerranUnit(19, "AP_UnlockValkyrie", UnlockStarport);
    AP_RegisterTerranUnit(55, "AP_UnlockRaven", UnlockStarport);
    AP_RegisterTerranUnit(56, "AP_UnlockScienceVessel", UnlockStarport);
    AP_RegisterTerranUnit(60, "AP_UnlockHercules", UnlockStarportAndFusionCore);

    // Elite Barracks
    AP_RegisterTerranUnit(29, "AP_UnlockAegisGuard", UnlockEliteBarracks);
    AP_RegisterTerranUnit(30, "AP_UnlockEmperorsShadow", UnlockEmperorsShadow);
    AP_RegisterTerranUnit(31, "AP_UnlockSonOfKorhal", UnlockEliteBarracks);
    AP_RegisterTerranUnit(33, "AP_UnlockFieldResponseTheta", UnlockEliteBarracks);

    // Elite Factory
    AP_RegisterTerranUnit(27, "AP_UnlockShockDivision", UnlockEliteFactory);
    AP_RegisterTerranUnit(28, "AP_UnlockBlackhammer", UnlockEliteFactory);
    AP_RegisterTerranUnit(32, "AP_UnlockBulwarkCompany", UnlockEliteFactory);

    // Elite Starport
    AP_RegisterTerranUnit(25, "AP_UnlockPrideOfAugustgrad", UnlockEliteStarport);
    AP_RegisterTerranUnit(26, "AP_UnlockSkyFury", UnlockEliteStarport);
    AP_RegisterTerranUnit(34, "AP_UnlockEmperorsGuardian", UnlockEliteStarport);
    AP_RegisterTerranUnit(35, "AP_UnlockNightHawk", UnlockEliteStarport);
    AP_RegisterTerranUnit(36, "AP_UnlockNightWolf", UnlockEliteStarport);

    // Mercenaries
    AP_RegisterTerranUnit(41, "AP_UnlockWarPigs", UnlockMercInfantry);
    AP_RegisterTerranUnit(42, "AP_UnlockDevilDogs", UnlockMercInfantry);
    AP_RegisterTerranUnit(43, "AP_UnlockHammerSecurities", UnlockMercInfantry);
    AP_RegisterTerranUnit(44, "AP_UnlockSpartanCompany", UnlockMercVehicles);
    AP_RegisterTerranUnit(45, "AP_UnlockSiegeBreakers", UnlockMercVehicles);
    AP_RegisterTerranUnit(46, "AP_UnlockHelsAngels", UnlockMercShips);
    AP_RegisterTerranUnit(47, "AP_UnlockDuskWings", UnlockMercShips);
    AP_RegisterTerranUnit(48, "AP_UnlockJacksonsRevenge", UnlockMercShips);
    AP_RegisterTerranUnit(49, "AP_UnlockSkibisAngels", UnlockMercInfantry);
    AP_RegisterTerranUnit(50, "AP_UnlockDeathHeads", UnlockMercInfantry);
    AP_RegisterTerranUnit(51, "AP_UnlockWingedNightmares", UnlockMercShips);
    AP_RegisterTerranUnit(52, "AP_UnlockMidnightRiders", UnlockMercShips);
    AP_RegisterTerranUnit(53, "AP_UnlockBrynhilds", UnlockMercShips);
    AP_RegisterTerranUnit(54, "AP_UnlockJotun", UnlockMercVehicles);

    // Buildings
    AP_RegisterTerranUnit(37, "AP_UnlockBunker", UnlockBarracks);
    AP_RegisterTerranUnit(38, "AP_UnlockMissileTurret", UnlockEngineeringBay);
    AP_RegisterTerranUnit(39, "AP_UnlockSensorTower", UnlockEngineeringBay);
    AP_RegisterTerranUnit(40, "AP_UnlockDevastatorTurret", UnlockFactory);
    AP_RegisterTerranUnit(57, "AP_UnlockPlanetaryFortress", UnlockEngineeringBay);
    AP_RegisterTerranUnit(58, "AP_UnlockPerditionTurret", UnlockEngineeringBay);
}

// Terran Item Unlock Functions
static void SelfSufficientFix (int player) {
    if (TechTreeUpgradeCount(player, "AP_SelfSufficient", c_techCountCompleteOnly) > 0) {
        TechTreeUpgradeAddLevel(player, "AP_SelfSufficient", -1);
        TechTreeUpgradeAddLevel(player, "AP_SelfSufficient", 1);
    }
}

static void BrynhildFunc (int player) {
    if (TechTreeUpgradeCount(player, "AP_SwannComanderVehicleWeaponRange", c_techCountCompleteOnly) > 0) {
        TechTreeUpgradeAddLevel(player, "AP_BrynhildRangeDoubleUpgrade", 1);
    }
}

static void DiamondbackFunc (int player) {
    int i;
    unit u;
    unitgroup g = UnitGroup("AP_Diamondback", player, RegionEntireMap(), UnitFilterStandard, 0);
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        u = UnitGroupUnit(g, i);
        UnitBehaviorAdd(u, "AP_BurstCapacitorsDamageBuff", u, 1);
    }
}

static void GraduatingRangeFunc (int player) {
    int i;
    unit u;
    string type;
    unitgroup g = UnitGroup(null, player, RegionEntireMap(), UnitFilterStandard, 0);
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        u = UnitGroupUnit(g, i);
        type = UnitGetType(u);
        if (
        (  type == "AP_SiegeTankSieged"
        || type == "AP_SiegeTankSiegedTransportable"
        || type == "AP_SiegeBreakerSieged"
        || type == "AP_SiegeBreakerSiegedTransportable"
        || type == "AP_InfestedSiegeBreakerSieged"
        || type == "AP_InfestedSiegeBreakerSiegedTransportable"
        )
        && !UnitHasBehavior2(u, "AP_SiegeTankSiegeModeProgressiveRangeIncease")) {   // Typo intended for now
            UnitBehaviorAdd(u, "AP_SiegeTankSiegeModeProgressiveRangeIncease", u, 1);
        }
    }
}

static void ThorNukeFunc(int player) {
    TechTreeUpgradeAddLevel(player, "AP_HaveGhostOrSpectreOrThorNuke", 1);
    UnlockShadowOps(player);
}
static void PredatorShieldsFunc(int player) {
    int ShieldRegenLevel = TechTreeUpgradeCount(player, "AP_ShieldRegenBonus", c_techCountCompleteOnly);
    int ShieldRegenLevel100Stack = TechTreeUpgradeCount(player, "AP_ShieldRegenBonus100Stack", c_techCountCompleteOnly);
    libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_ShieldRegenBonusPredator", ShieldRegenLevel);
    libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_ShieldRegenBonusPredator100Stack", ShieldRegenLevel100Stack);
}

static void MedivacShieldFunc(int player) {
    int ShieldRegenLevel = TechTreeUpgradeCount(player, "AP_ShieldRegenBonus", c_techCountCompleteOnly);
    int ShieldRegenLevel100Stack = TechTreeUpgradeCount(player, "AP_ShieldRegenBonus100Stack", c_techCountCompleteOnly);
    libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_ShieldRegenBonusMedivac", ShieldRegenLevel);
    libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_ShieldRegenBonusMedivac100Stack", ShieldRegenLevel100Stack);
}

static void VikingRangeFunc (int player) {
    if (TechTreeUpgradeCount(player, "AP_SwannComanderVehicleWeaponRange", c_techCountCompleteOnly) > 0) {
        TechTreeUpgradeAddLevel(player, "AP_VikingRangeDoubleUpgrade", 1);
    }
}

static void LiberatorCloakFunc (int player) {
    int i;
    unit u;
    unitgroup g;
    fixed startingEnergy = 50;
    if (TechTreeUpgradeCount(player, "AP_CloakingTechnologyLiberator", c_techCountCompleteOnly) > 0 ) {
        return;
    }
    // add upgrade here to ensure starting energy is added properly
    TechTreeUpgradeAddLevel(player, "AP_CloakingTechnologyLiberator", 1);
    if (TechTreeUpgradeCount(player, "AP_CellularReactors", c_techCountCompleteOnly) > 0) {
        TechTreeUpgradeAddLevel(player, "AP_CellularReactorsLiberator", 1);
        startingEnergy = 150;
    }
    g = UnitGroup("AP_Liberator", player, RegionEntireMap(), UnitFilterStandard, 0);
    UnitGroupAddUnitGroup(g, UnitGroup("AP_LiberatorAG", player, RegionEntireMap(), UnitFilterStandard, 0));
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        u = UnitGroupUnit(g, i);
        UnitSetPropertyFixed(u, c_unitPropEnergy, startingEnergy);
    }
}

static void BunkerFortifiedShrikeFunc (int player) {
    if (TechTreeUpgradeCount(player, "AP_ShrikeTurret", c_techCountCompleteOnly) > 0
    || TechTreeUpgradeCount(player, "AP_FortifiedBunkerCarapace", c_techCountCompleteOnly) > 0
    ) {
        TechTreeUpgradeAddLevel(player, "AP_NeoSteelAndShrikeTurretIconUpgrade", 1);
    }
}

static void PlanetaryFortressAirAttackFunc (int player) {
    if (TechTreeUpgradeCount(player, "AP_PlanetaryFortressWeapon", c_techCountCompleteOnly) > 0 ) {
        TechTreeUpgradeAddLevel(player, "AP_PlanetaryFortressAirAttackFlying", 1);
    }
    return;
}

static void PlanetaryFortressOrbitalModuleFunc (int player) {
    int i;
    unit u;
    unitgroup g;
    fixed startingEnergy = 50;
    if (TechTreeUpgradeCount(player, "AP_OrbitalRelayPlanetary", c_techCountCompleteOnly) > 0 ) {
        return;
    }
    // add upgrade here to ensure starting energy is added properly
    TechTreeUpgradeAddLevel(player, "AP_OrbitalRelayPlanetary", 1);
    g = UnitGroup("AP_PlanetaryFortress", player, RegionEntireMap(), UnitFilterStandard, 0);
    UnitGroupAddUnitGroup(g, UnitGroup("AP_PlanetaryFortressFlying", player, RegionEntireMap(), UnitFilterStandard, 0));
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        u = UnitGroupUnit(g, i);
        UnitSetPropertyFixed(u, c_unitPropEnergy, startingEnergy);
    }
}

static void UnlockOrbitalCommand (int player) {
    int i;
    unit u;
    unitgroup g;
    fixed startingEnergy = 50;
    if (TechTreeUpgradeCount(player, "AP_OrbitalRelay", c_techCountCompleteOnly) > 0 ) {
        return;
    }
    TechTreeUpgradeAddLevel(player, "AP_OrbitalRelay", 1);
    g = UnitGroup("AP_CommandCenter", player, RegionEntireMap(), UnitFilterStandard, 0);
    UnitGroupAddUnitGroup(g, UnitGroup("AP_CommandCenterFlying", player, RegionEntireMap(), UnitFilterStandard, 0));
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        u = UnitGroupUnit(g, i);
        UnitSetPropertyFixed(u, c_unitPropEnergy, startingEnergy);
    }
}

static void UnlockNovaNuke (int player) {
    UnlockShadowOps(player);
    TechTreeUpgradeAddLevel(player, "AP_NovaEnabled", 1);
}

static void UltraCapacitorsFunc (int player) {
    int i; int j;
    string oldUpgrade = "AP_TerranInfantryWeaponsPreplacedNoBuild";
    string newUpgrade = "AP_TerranInfantryWeaponsUltraCapacitorsPreplacedNoBuild";
    string[3] type;
    libABFE498B_gf_AP_Triggers_replaceUpgrade(player, oldUpgrade, newUpgrade);
    type[0] = "Infantry";
    type[1] = "Vehicle";
    type[2] = "Ship";
    for (i = 1; i <= 5; i +=1) {
        for (j = 0; j < 3; j += 1) {
            oldUpgrade = "AP_Terran" + type[j] + "WeaponsLevel" + IntToString(i);
            newUpgrade = "AP_Terran" + type[j] + "WeaponsUltraCapacitorsLevel" + IntToString(i);
            libABFE498B_gf_AP_Triggers_replaceUpgrade(player, oldUpgrade, newUpgrade);
        }
    }
}

static void VanadiumPlatingFunc (int player) {
    int i; int j;
    string oldUpgrade = "AP_TerranInfantryArmorsPreplacedNoBuild";
    string newUpgrade = "AP_TerranInfantryArmorsVanadiumPlatingPreplacedNoBuild";
    string[3] type;
    libABFE498B_gf_AP_Triggers_replaceUpgrade(player, oldUpgrade, newUpgrade);
    type[0] = "Infantry";
    type[1] = "Vehicle";
    type[2] = "Ship";
    for (i = 1; i <= 5; i +=1) {
        for (j = 0; j < 3; j += 1) {
            oldUpgrade = "AP_Terran" + type[j] + "ArmorsLevel" + IntToString(i);
            newUpgrade = "AP_Terran" + type[j] + "ArmorsVanadiumPlatingLevel" + IntToString(i);
            libABFE498B_gf_AP_Triggers_replaceUpgrade(player, oldUpgrade, newUpgrade);
        }
    }
}

static void CellularReactorFunc (int player) {
    if (TechTreeUpgradeCount(player, "AP_CloakingTechnologyLiberator", c_techCountCompleteOnly) > 0) {
        TechTreeUpgradeAddLevel(player, "AP_CellularReactorsLiberator", 1);
    }
    if (TechTreeUpgradeCount(player, "AP_CloakingTechnologyPredator", c_techCountCompleteOnly) > 0) {
        TechTreeUpgradeAddLevel(player, "AP_CellularReactorsPredator", 1);
    }
}

static void AdvancedOpticsFunc (int player) {
    if (TechTreeUpgradeCount(player, "AP_AresClassWeaponsSystemViking", c_techCountCompleteOnly) > 0) {
        TechTreeUpgradeAddLevel(player, "AP_VikingRangeDoubleUpgrade", 1);
    }
    if (TechTreeUpgradeCount(player, "AP_AresClassWeaponsSystems", c_techCountCompleteOnly) > 0) {
        TechTreeUpgradeAddLevel(player, "AP_BrynhildRangeDoubleUpgrade", 1);
    }
}

static void RapidReinforcementFunc (int player) {
    int i;
    string cooldownLink;
    if (TechTreeUpgradeCount(player, "AP_RapidReinforcement", c_techCountCompleteOnly) > 0 ) {
        return;
    }
    TechTreeUpgradeAddLevel(player, "AP_RapidReinforcement", 1);
    for (i = 0; i < lib15EF4C78_gv_aP_Player_MERC_COOLDOWN_LINK_SIZE; i += 1) {
        if ( lib15EF4C78_gv_aP_Player_MercType[i] == lib15EF4C78_ge_AP_Player_MercenaryType_INFANTRY
        || lib15EF4C78_gv_aP_Player_MercType[i] == lib15EF4C78_ge_AP_Player_MercenaryType_VEHICLE
        || lib15EF4C78_gv_aP_Player_MercType[i] == lib15EF4C78_ge_AP_Player_MercenaryType_STARSHIP
        ) {
            cooldownLink = lib15EF4C78_gv_aP_Player_MercCooldownLinks[i];
            PlayerAddCooldown(player, cooldownLink, -60.0);
        }
    }
}

static void VultureMagazineFunc(int player, int level) {
    int i;
    unit u;
    unitgroup g;
    order o;
    if (TechTreeUpgradeCount(player, "AP_ReplenishSpiderMineFree", c_techCountCompleteOnly) > 0 ) {
        return;
    }
    if (level >= 1) {
        TechTreeUpgradeAddLevel(player, "AP_NanoConstructor", 1);
        if (level >= 2) {
            TechTreeUpgradeAddLevel(player, "AP_ReplenishSpiderMineFree", 1);
            g = UnitGroup("AP_Vulture", player, RegionEntireMap(), UnitFilterStandard, 0);
            o = OrderSetAutoCast(AbilityCommand("AP_MakeVultureSpiderMines", 0), true);
            UnitGroupIssueOrder(g, o, c_orderQueueAddToFront);
        }
    }
}

static void BattlecruiserShieldsFunc(int player, int level) {
    if (level >= 1) {
        TechTreeUpgradeAddLevel(player, "AP_DefensiveMatrix", 1);
        if (level >= 2) {
            TechTreeUpgradeAddLevel(player, "AP_BattlecruiserAdvancedDefensiveMatrix", 1);
            libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_ShieldRegenBonusBattlecruiser", 1);
            libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_ShieldRegenBonusBattlecruiser100Stack", 1);
        }
    }
}

static void PlanetaryLiftoffFunc(int player, int level) {
    if (level >= 1) {
        TechTreeUpgradeAddLevel(player, "AP_PlanetaryFortressLiftOff", 1);
        if (level >= 2) {
            TechTreeUpgradeAddLevel(player, "AP_PlanetaryFortressWeapon", 1);
            if (TechTreeUpgradeCount(player, "AP_PlanetaryFortressAirAttack", c_techCountCompleteOnly) > 0) {
                TechTreeUpgradeAddLevel(player, "AP_PlanetaryFortressAirAttackFlying", 1);
            }
        }
    }
}

static void FastDeliveryFunc(int player, int level) {
    int index;
    int upgradeLevel = TechTreeUpgradeCount(player, "AP_FastDeliveryLevel1", c_techCountCompleteOnly);
    int upgradeLevel2 = TechTreeUpgradeCount(player, "AP_FastDelivery", c_techCountCompleteOnly);
    if (level >= 1 && upgradeLevel == 0) {
        TechTreeUpgradeAddLevel(player, "AP_FastDeliveryLevel1", 1);
        lib15EF4C78_gf_AP_Player_ClearMercenaryCooldownsTerran(player);
    }
    if (level >= 2 && upgradeLevel2 == 0) {
        TechTreeUpgradeAddLevel(player, "AP_FastDelivery", 1);
        lib15EF4C78_gf_AP_Player_ClearMercenaryCooldownsTerran(player);
    }
    libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_FastDeliveryCharges", lib15EF4C78_gf_AP_Player_MercCompoundGetInstantUses(player));
}

static void BioSteelFunc(int player, int level) {
    if (level >= 1) {
        TechTreeUpgradeAddLevel(player, "AP_RegenerativeBioSteel", 1);
        if (level >= 2) {
            TechTreeUpgradeAddLevel(player, "AP_RegenerativeBioSteelLevel2", 1);
            if (level >= 3) {
                TechTreeUpgradeAddLevel(player, "AP_RegenerativeBioSteelLevel3", 1);
            }
        }
    }
}

static void TerranInfantryWeaponFunc (int player, int level) {
    int index = 0;
    int modifier = 1;
    UnlockEngineeringBay(player);
    if (TechTreeUpgradeCount(player, "AP_UltraCapacitors", c_techCountCompleteOnly) > 0 ) {
        index += 1;
        modifier = -1;
    }
    AP_HandleTerranUpgrade(player, level , index, modifier);
}

