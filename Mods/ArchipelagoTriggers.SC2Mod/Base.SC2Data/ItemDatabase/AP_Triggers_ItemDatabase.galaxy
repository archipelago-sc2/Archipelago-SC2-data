// Protoss Item Unlock Functions
static void SentinelRechargeFunc(int player) {
    TriggerEnable(lib15EF4C78_gt_AP_Player_SentinelRecharge, true);
}

static void SupplicantShieldRegenFunc(int player) {
    int lvl = TechTreeUpgradeCount(player, "AP_ShieldRegenBonus", c_techCountCompleteOnly);
    libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_ShieldRegenBonusSupplicantBoosted", lvl);
    lvl = TechTreeUpgradeCount(player, "AP_ShieldRegenBonus100Stack", c_techCountCompleteOnly);
    libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_ShieldRegenBonusSupplicantBoosted100Stack", lvl);
}

static void SupplicantSacrificeFunc(int player) {
    PlayerAddResponse(player,"AP_SupplicantSacrifice");
}

static void DragoonShieldRegenFunc(int player) {
    int lvl = TechTreeUpgradeCount(player, "AP_ShieldRegenBonus", c_techCountCompleteOnly);
    libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_ShieldRegenBonusDragoonTrillic", lvl);
    lvl = TechTreeUpgradeCount(player, "AP_ShieldRegenBonus100Stack", c_techCountCompleteOnly);
    libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_ShieldRegenBonusDragoonTrillic100Stack", lvl);
}

static void HighTemplarKhaydarinAmuletFunc(int player) {
    if (TechTreeUpgradeCount(player, "AP_HighArchon", c_techCountCompleteOnly) > 0) {
        TechTreeUpgradeAddLevel(player, "AP_KhaydarinAmuletArchon", 1);
    }
}

static void HighArchonFunc(int player) {
    fixed startingEnergy = 50;
    unitgroup g;
    unit u;
    int i;
    if (TechTreeUpgradeCount(player, "AP_HighArchon", c_techCountCompleteOnly) > 0) {return;}
    TechTreeUpgradeAddLevel(player, "AP_HighArchon", 1);
    if (TechTreeUpgradeCount(player, "AP_KhaydarinAmulet", c_techCountCompleteOnly) > 0) {
        startingEnergy = 200;
    }
    g = UnitGroup("AP_Archon", player, RegionEntireMap(), UnitFilterStandard, 0);
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        u = UnitGroupUnit(g, i);
        UnitSetPropertyFixed(u, c_unitPropEnergy, startingEnergy);
    }
}

static void DarkTemplarShadowFuryFunc(int player) {
    if (TechTreeUpgradeCount(player, "AP_DarkTemplarShadowFuryLesser", c_techCountCompleteOnly) > 0
    && TechTreeUpgradeCount(player, "AP_DarkTemplarShadowFuryGreater", c_techCountCompleteOnly) > 0
    ) {
        TechTreeUpgradeAddLevel(player, "AP_DarkTemplarShadowFuryAll", 1);
    }
}

static void BloodHunterAlaraksCallFunc(int player) {
    lib15EF4C78_gf_AP_Player_Protoss_activateBloodHunterResourceEfficiency(player);
}

static void ArtanisAiurAspectFunc(int player) {
    TechTreeUpgradeAddLevel(player, "AP_ArtanisAiurAspectUnlocked", 1);
}
static void ArtanisNerazimAspectFunc(int player) {
    TechTreeUpgradeAddLevel(player, "AP_ArtanisNerazimAspectUnlocked", 1);
}

static void ArtanisPurifierAspectFunc(int player) {
    TechTreeUpgradeAddLevel(player, "AP_ArtanisPurifierAspectUnlocked", 1);
}

static void ArtanisTaldarimAspectFunc(int player) {
    TechTreeUpgradeAddLevel(player, "AP_ArtanisTaldarimAspectUnlocked", 1);
}

static void NexusPowerFunc(int player) {
    unitgroup g;
    unit u;
    int i;
    g = UnitGroup("AP_Nexus", player, RegionEntireMap(), UnitFilterStandard, 0);
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        u = UnitGroupUnit(g, i);
        lib15EF4C78_gf_AP_Player_ReapplyDefaultBehaviorsToUnit(u);
    }
}

static void QuatroFunc(int player) {
    TechTreeUpgradeAddLevel(player, "AP_ProtossAirArmorsQuatro", 1);
    TechTreeUpgradeAddLevel(player, "AP_ProtossAirWeaponsQuatro", 1);
    TechTreeUpgradeAddLevel(player, "AP_ProtossGroundArmorsQuatro", 1);
    TechTreeUpgradeAddLevel(player, "AP_ProtossGroundWeaponsQuatro", 1);
    TechTreeUpgradeAddLevel(player, "AP_ProtossShieldsQuatro", 1);
}

static void SoAProxyPylonFunc(int player, int level) {
    if (level == 1) {
        libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_SOAProxyPylon", 1);
    }
    if (level >= 2) {
        libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_SOAProxyPylon", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_SOAWarpInReinforcements", 1);
    }
}

static void ProtossGroundWeaponFunc (int player, int level) {
    UnlockForge(player);
    AP_HandleProtossUpgrade(player, level, 0);
}

static void ProtossGroundArmorFunc (int player, int level) {
    UnlockForge(player);
    AP_HandleProtossUpgrade(player, level, 1);
}

static void ProtossAirWeaponFunc (int player, int level) {
    UnlockCyberneticsCore(player);
    AP_HandleProtossUpgrade(player, level, 2);
}

static void ProtossAirArmorFunc (int player, int level) {
    UnlockCyberneticsCore(player);
    AP_HandleProtossUpgrade(player, level, 3);
}

static void ProtossShieldsFunc (int player, int level) {
    UnlockForge(player);
    AP_HandleProtossUpgrade(player, level, 4);
}

