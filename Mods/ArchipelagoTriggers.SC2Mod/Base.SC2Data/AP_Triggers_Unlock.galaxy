static void TerranVehicleArmorFunc (int player, int level) {
    int index = 6;
    int modifier = 1;
    UnlockArmory(player);
    if (TechTreeUpgradeCount(player, "AP_VanadiumPlating", c_techCountCompleteOnly) > 0 ) {
        index += 1;
        modifier = -1;
    }
    HandleTerranUpgrade(player, level, index, modifier);
}

static void TerranShipWeaponFunc (int player, int level) {
    int index = 8;
    int modifier = 1;
    UnlockArmory(player);
    if (TechTreeUpgradeCount(player, "AP_UltraCapacitors", c_techCountCompleteOnly) > 0 ) {
        index += 1;
        modifier = -1;
    }
    HandleTerranUpgrade(player, level, index, modifier);
}

static void TerranShipArmorFunc (int player, int level) {
    int index = 10;
    int modifier = 1;
    UnlockArmory(player);
    if (TechTreeUpgradeCount(player, "AP_VanadiumPlating", c_techCountCompleteOnly) > 0 ) {
        index += 1;
        modifier = -1;
    }
    HandleTerranUpgrade(player, level, index, modifier);
}

static void Setup() {
    int level; int i; int j;
    string[3] unitTypes;
    string[2] add;
    string id;
    TypeToOffset[TYPE_TERRAN_UNIT] = OFFSET_TERRAN_UNIT;
    TypeToOffset[TYPE_TERRAN_ITEM] = OFFSET_TERRAN_ITEM;
    TypeToOffset[TYPE_ZERG_UNIT] = OFFSET_ZERG_UNIT;
    TypeToOffset[TYPE_ZERG_ITEM] = OFFSET_ZERG_ITEM;
    TypeToOffset[TYPE_PROTOSS_UNIT] = OFFSET_PROTOSS_UNIT;
    TypeToOffset[TYPE_PROTOSS_ITEM] = OFFSET_PROTOSS_ITEM;

    // Weapon Upgrades Setup
    unitTypes[0] = "Infantry";
    unitTypes[1] = "Vehicle";
    unitTypes[2] =  "Ship";
    add[0] = "UltraCapacitors";
    add[1] = "VanadiumPlating";
    for (i = 0; i < 3; i += 1) {
        for (j = 0; j < 5; j += 1) {
            level = j + 1;
            id = "AP_Terran" + unitTypes[i] + "Weapons" + "Level" + IntToString(level);
            WAUpgradeDatabase[4 * i][j] = id;
            id = "AP_Terran" + unitTypes[i] + "Weapons" + add[0] + "Level" + IntToString(level);
            WAUpgradeDatabase[4 * i + 1][j] = id;
            id = "AP_Terran" + unitTypes[i] + "Armors" + "Level" + IntToString(level);
            WAUpgradeDatabase[4 * i + 2][j] = id;
            id = "AP_Terran" + unitTypes[i] + "Armors" + add[1] + "Level" + IntToString(level);
            WAUpgradeDatabase[4 * i + 3][j] = id;
        }
    }
}

void AP_UnlockTerranUnits(int player, string hexInput) {
    UnlockItems(player, TYPE_TERRAN_UNIT, hexInput);
}

void AP_UnlockProtossUnits(int player, string hexInput) {
    log("unlocking protoss units");
    UnlockItems(player, TYPE_PROTOSS_UNIT, hexInput);
}

void AP_UnlockTerranItems(int player, string hexInput) {
    UnlockItems(player, TYPE_TERRAN_ITEM, hexInput);
}

void AP_UnlockProtossItems(int player, string hexInput) {
    UnlockItems(player, TYPE_PROTOSS_ITEM, hexInput);
}

void AP_UnlockTerranProgressives(int player, string hexInput) {
    UnlockProgressives(player, hexInput);
}

void AP_UnlockProtossProgressives(int player, string hexInput) {
}

void AP_UnlockTerranUpgrades(int player, string hexInput) {
    UnlockUpgrades(player, hexInput);
}

void AP_UnlockProtossUpgrades(int player, string hexInput) {
}



void AP_ResetTerranTech(int player) {
    //for testing
    TechTreeUpgradeAddLevel(player, "AP_UnlockBarracks" , -1);
    TechTreeUpgradeAddLevel(player, "AP_UnlockBarracksReactor" , -1);
    TechTreeUpgradeAddLevel(player, "AP_UnlockBarracksTechLab" , -1);

    TechTreeUpgradeAddLevel(player, "AP_UnlockMarine" , -1);
    TechTreeUpgradeAddLevel(player, "AP_UnlockMedic" , -1);
    TechTreeUpgradeAddLevel(player, "AP_UnlockFirebat" , -1);
    TechTreeUpgradeAddLevel(player, "AP_UnlockMarauder" , -1);

    TechTreeUpgradeAddLevel(player, "AP_CombatShield" , -1);
    TechTreeUpgradeAddLevel(player, "AP_MarineStimpack" , -1);
    TechTreeUpgradeAddLevel(player, "AP_SuperStimpackMarine" , -1);
    TechTreeUpgradeAddLevel(player, "AP_LaserTargetingSystemMarine" , -1);
}

