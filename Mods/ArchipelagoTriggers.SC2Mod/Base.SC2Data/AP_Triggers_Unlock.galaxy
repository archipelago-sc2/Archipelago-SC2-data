    TechTreeUpgradeAddLevel(player, "AP_UnlockTemplarArchives", 1);
}

void UnlockDarkShrine(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockDarkShrine", 1);
}

void UnlockGatewayAndCyberneticsCore(int player) {
    UnlockGateway(player);
