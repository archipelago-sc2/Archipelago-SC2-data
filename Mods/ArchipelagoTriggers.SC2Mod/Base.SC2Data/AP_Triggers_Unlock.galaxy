static void DiamondbackFunc (int player) {
    int i;
    unit u;
    unitgroup g = UnitGroup("AP_Diamondback", player, RegionEntireMap(), UnitFilterStandard, 0);
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        u = UnitGroupUnit(g, i);
        UnitBehaviorAdd(u, "AP_BurstCapacitorsDamageBuff", u, 1);
    }
}

static void GraduatingRangeFunc (int player) {
    int i;
    unit u;
    string type;
    unitgroup g = UnitGroup(null, player, RegionEntireMap(), UnitFilterStandard, 0);
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        u = UnitGroupUnit(g, i);
        type = UnitGetType(u);
        if (
        (  type == "AP_SiegeTankSieged"
        || type == "AP_SiegeTankSiegedTransportable"
        || type == "AP_SiegeBreakerSieged"
        || type == "AP_SiegeBreakerSiegedTransportable"
        || type == "AP_InfestedSiegeBreakerSieged"
        || type == "AP_InfestedSiegeBreakerSiegedTransportable"
        )
        && !UnitHasBehavior2(u, "AP_SiegeTankSiegeModeProgressiveRangeIncrease")
        ){
            UnitBehaviorAdd(u, "AP_SiegeTankSiegeModeProgressiveRangeIncrease", u, 1);
        }
    }
}

