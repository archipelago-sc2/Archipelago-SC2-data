// A library for handling AP item unlocks
include "AP_Triggers_Unlock.h"

// Constants
static const int ITEM_SPACE = 5000;
static const int TYPE_TERRAN_UNIT = 0;
static const int TYPE_TERRAN_ITEM = 1;
static const int TYPE_ZERG_UNIT = 2;
static const int TYPE_ZERG_ITEM = 3;
static const int TYPE_PROTOSS_UNIT = 4;
static const int TYPE_PROTOSS_ITEM = 5;
static const int OFFSET_TERRAN_UNIT = 0;
static const int OFFSET_TERRAN_ITEM = OFFSET_TERRAN_UNIT + 200;
static const int OFFSET_ZERG_UNIT = OFFSET_TERRAN_ITEM + 500;
static const int OFFSET_ZERG_ITEM = OFFSET_ZERG_UNIT + 200;
static const int OFFSET_PROTOSS_UNIT = OFFSET_ZERG_ITEM + 500;
static const int OFFSET_PROTOSS_ITEM = OFFSET_PROTOSS_UNIT + 200;


static const int PROGRESSIVE_SPACE = 200;
static const int OFFSET_UPGRADE = 50;

// Globals
static void ItemFuncSignature(int player) {}
typedef funcref<ItemFuncSignature> AP_ItemFunc;
struct AP_Item {
    int Id;
    string Upgrade;
    AP_ItemFunc UnlockFunc;
};
static AP_Item[ITEM_SPACE] ItemDatabase;
static int[20] TypeToOffset;
static string[12][5] WAUpgradeDatabase;

static void ProgressiveFuncSignature(int player, int level) {}
typedef funcref<ProgressiveFuncSignature> AP_ProgressiveFunc;
struct AP_Progressive {
    int Id;
    string UpgradeLevel1;
    string UpgradeLevel2;
    AP_ProgressiveFunc UnlockFunc;
};
static AP_Progressive[PROGRESSIVE_SPACE] ProgressiveDatabase;

static unitfilter UnitFilterStandard = UnitFilter(0, 0, (1 << c_targetFilterMissile),
    (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)));

// Functions
static void log(string s) {
    TriggerDebugOutput(1, StringToText("Unlock: " + s), true);
}

static void RegisterItem(int id, int type, string upgrade, AP_ItemFunc itemFunc) {
    int index = id + TypeToOffset[type];
    ItemDatabase[index].Id = id;
    ItemDatabase[index].Upgrade = upgrade;
    ItemDatabase[index].UnlockFunc = itemFunc;
}

static void RegisterTerranUnit(int id, string upgrade,  AP_ItemFunc itemFunc) {
    RegisterItem(id, TYPE_TERRAN_UNIT, upgrade, itemFunc);
}

static void RegisterProtossUnit(int id, string upgrade,  AP_ItemFunc itemFunc) {
    RegisterItem(id, TYPE_PROTOSS_UNIT, upgrade, itemFunc);
}

static void RegisterTerranItem(int id, string upgrade) {
    RegisterItem(id, TYPE_TERRAN_ITEM, upgrade, null);
}

static void RegisterTerranItemFunc(int id, string upgrade, AP_ItemFunc itemFunc) {
    RegisterItem(id, TYPE_TERRAN_ITEM, upgrade, itemFunc);
}

static void RegisterProtossItem(int id, string upgrade) {
    RegisterItem(id, TYPE_PROTOSS_ITEM, upgrade, null);
}

static void RegisterProtossItemFunc(int id, string upgrade,  AP_ItemFunc itemFunc) {
    RegisterItem(id, TYPE_PROTOSS_ITEM, upgrade, itemFunc);
}


static void RegisterProgressive(int id, int offset, int bits, string upgrade1, string upgrade2, AP_ProgressiveFunc itemFunc) {
    int index = id/bits + offset;
    ProgressiveDatabase[index].Id = id;
    ProgressiveDatabase[index].UpgradeLevel1 = upgrade1;
    ProgressiveDatabase[index].UpgradeLevel2 = upgrade2;
    ProgressiveDatabase[index].UnlockFunc = itemFunc;
}

static void RegisterTerranProgressiveFunc(int id, AP_ProgressiveFunc itemFunc) {
    RegisterProgressive(id, 0, 2, null, null, itemFunc);
}

static void RegisterTerranProgressive(int id, string upgrade1, string upgrade2) {
    // common case of progressive with 2 levels. More levels/upgrades needs to handle it with the function.
    RegisterProgressive(id, 0, 2, upgrade1, upgrade2, null);
}

static void RegisterTerranUpgrade(int id, AP_ProgressiveFunc itemFunc) {
    RegisterProgressive(id, OFFSET_UPGRADE, 4, null, null, itemFunc);
}
static void UnlockItem(int player, int index) {
    log("unlocking index: "+IntToString(index));
    if (ItemDatabase[index].Upgrade != null) {
        TechTreeUpgradeAddLevel(player, ItemDatabase[index].Upgrade, 1);
    }
    if (ItemDatabase[index].UnlockFunc != null) {
        ItemDatabase[index].UnlockFunc(player);
    }
}

static void UnlockProgressive(int player, int index, int offset, int level) {
    int slot = ProgressiveDatabase[index + offset].Id;
    index += offset;
    // log("unlocking progressive level: " + IntToString(level) + " at slot: "+ IntToString(slot));
    if (level >= 1 && ProgressiveDatabase[index].UpgradeLevel1 != null) {
        TechTreeUpgradeAddLevel(player, ProgressiveDatabase[index].UpgradeLevel1, 1);
    }
    if (level >= 2 && ProgressiveDatabase[index].UpgradeLevel2 != null) {
        TechTreeUpgradeAddLevel(player, ProgressiveDatabase[index].UpgradeLevel2, 1);
    }
    if (ProgressiveDatabase[index].UnlockFunc != null) {
        ProgressiveDatabase[index].UnlockFunc(player, level);
    }
}

static void UnlockItems(int player, int type, string hexInput) {
    int length = StringLength(hexInput);
    int fourBits;
    int index;
    int offset = TypeToOffset[type];
    int i; int j;
    for (i = OFFSET_PROTOSS_UNIT; i < OFFSET_PROTOSS_UNIT + 200; i += 1) {
        if (ItemDatabase[i].Upgrade != null) {
            log("Upgrade " + ItemDatabase[i].Upgrade + " at index: " + IntToString(i));
        }
    }
    log("Input: "+hexInput);
    for (i = length; i > 0; i -= 1) {
        fourBits = AP_HexDigitToInt(StringSub(hexInput, i, i));
        log("four bits "+IntToString(i)+": "+IntToString(fourBits));
        if (fourBits <= 0) { continue; }
        for (j = 0; j < 4; j += 1) {
            index = (4 * (length - i)) + j + offset;
            if ((fourBits & 1) == 1) {
                UnlockItem(player, index);
            }
            fourBits = (fourBits >> 1);
        }
    }
}

// Regular progressive items always consume 2 bits (which means their max lvl is 3)
// anything with higher lvls needs to be handled separately
static void UnlockProgressives(int player, string hexInput) {
    int length = StringLength(hexInput);
    int fourBits;
    int level;
    int index;
    int i; int j;
    //log("Input: "+hexInput);
    for (i = length; i > 0; i -= 1) {
        fourBits = AP_HexDigitToInt(StringSub(hexInput, i, i));
        //log("FourBits: " + IntToString(fourBits));
        for (j = 0; j < 2; j += 1) {
            if (fourBits <= 0) { continue; }
            index = 2 * (length - i) + j;
            level = fourBits & 3;
            UnlockProgressive(player, index, 0, level);
            fourBits = (fourBits >> 2);
        }
    }
}

// W/A upgrades always consume 1 full hex char
static void UnlockUpgrades(int player, string hexInput) {
    int length = StringLength(hexInput);
    int fourBits;
    int level;
    int index;
    int i;
    // log("Upgrades Input: "+hexInput);
    for (i = length; i > 0; i -= 1) {
        fourBits = AP_HexDigitToInt(StringSub(hexInput, i, i));
        // log("FourBits: " + IntToString(fourBits));
        if (fourBits <= 0) { continue; }
        index = length - i;
        UnlockProgressive(player, index, OFFSET_UPGRADE, fourBits);
    }
}

