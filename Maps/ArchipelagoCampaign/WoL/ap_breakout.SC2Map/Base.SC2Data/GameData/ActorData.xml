    <CActorModel id="PrologueVoidArmor">
        <Inherits index="BaseModelScale" value="1"/>
        <Inherits index="Scale" value="1"/>
        <On Terms="ActorCreation" Send="TimerSet 0.600000 DelayAnim"/>
        <On Terms="ActorCreation" Send="StatusSet FailSafe 1"/>
        <On Terms="TimerExpired; TimerName DelayAnim" Send="AnimBracketStart BSD Birth Stand Death"/>
        <On Terms="TimerExpired; TimerName DelayAnim" Send="StatusSet FailSafe 0"/>
        <On Terms="ActorOrphan" Send="Destroy"/>
        <On Terms="AnimBracketState.*.AfterClosing; !AnimBracketExitReason ModelSwap; AnimName BSD" Send="Destroy"/>
        <On Terms="Behavior.PrologueVoidArmor.On" Send="Create"/>
        <On Terms="Behavior.PrologueVoidArmor.Off; IsStatus FailSafe 1" Send="Destroy"/>
        <On Terms="Behavior.PrologueVoidArmor.Off; IsStatus FailSafe 0" Send="AnimBracketStop BSD"/>
        <On Terms="ActorCreation" Send="Create PrologueVoidArmorStartSound"/>
        <On Terms="Behavior.PrologueVoidArmor.Off" Send="Create PrologueVoidArmorEndSound"/>
        <Host Subject="_Selectable"/>
        <HostSiteOps Ops="SOpAttachCenter"/>
        <AutoScaleFactor value="1.000000"/>
        <ModelFlags index="AutomateGlobalLoops" value="1"/>
    </CActorModel>
    <CActorModel id="PrologueVoidArmorLaunch" parent="ModelAnimationStyleOneShot">
        <On Terms="Effect.PrologueVoidArmorSearch.Start" Send="Create"/>
        <On Terms="ActorCreation" Send="Create PrologueVoidArmorLaunchSound"/>
        <Host Subject="_Selectable"/>
        <HostSiteOps Ops="SOpAttachCenter SOp2DRotation" HoldPosition="1" HoldRotation="1"/>
    </CActorModel>
    <CActorSound id="PrologueVoidArmorStartSound" parent="SoundOneShot"/>
    <CActorSound id="PrologueVoidArmorEndSound" parent="SoundOneShot"/>
    <CActorSound id="PrologueVoidArmorLaunchSound" parent="SoundOneShot"/>
    <!--                                                                                         -->
    <!-- Zeratul ............................................................................... -->
    <!--                                                                                         -->
    <CActorUnit id="Zeratul">
        <!-- Override -->
        <On Terms="UnitMovementUpdate.*.Walk" Send="AnimClear Spell"/>
        <On Terms="Abil.ShadowBlade.SourceCastStart" Send="$Spell 0 -1.000000 -1.000000 1.200000 AsDuration"/>
        <On Terms="Abil.ShadowBlade.SourceCastStart" Target="_Unit" Send="Create TemporalFieldImpactModel"/>
        <On Terms="Abil.ShadowBlade.SourceCastStart" Send="Create ShadowBladeWeaponAttach"/>
        <On Terms="Abil.ShadowBlade.SourceFinishStop" Target="TemporalFieldImpactModel" Send="Destroy"/>
        <On Terms="Abil.ShadowBlade.SourceFinishStop" Target="ShadowBladeWeaponAttach" Send="Destroy"/>
        <On Terms="Abil.ZeratulOrbitalStrike.SourcePrepStart" Send="AnimBracketStart Spell Stand,Work,Start Stand,Work Stand,Work,End"/>
        <On Terms="Abil.ZeratulOrbitalStrike.SourceChannelStop" Send="AnimBracketStop Spell"/>
    </CActorUnit>
    <CActorAction id="ZeratulOrbitalStrikeAction" parent="AoESplashShieldHitter" effectHit="ZeratulOrbitalStrikeDamage">
        <EditorCategories value=""/>
    </CActorAction>
