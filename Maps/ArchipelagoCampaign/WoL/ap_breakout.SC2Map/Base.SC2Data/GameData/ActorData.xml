        <On Terms="Effect.ZeratulOrbitalStrike.Stop" Send="AnimBracketStop BSD"/>
        <On Terms="ActorCreation" Send="AnimBracketStart BSD Birth Stand Death ContentForceLooping"/>
        <On Terms="AnimBracketState.*.AfterClosing; AnimName BSD" Send="Destroy"/>
        <On Terms="ActorCreation" Send="Create ZeratulOrbitalStrikeMarkerSound"/>
        <Model value="AP_VoidProtossAOECursorSplat"/>
        <Scale value="8.000000"/>
        <ModelFlags index="AutomateGlobalLoops" value="1"/>
    </CActorModel>
    <CActorModel id="ZeratulOrbitalStrikeMissile" parent="ModelAnimationStyleOneShot">
